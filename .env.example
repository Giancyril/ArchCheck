# Google Gemini API (used for vision analysis, architecture interpretation, and feedback generation)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Cloud Vision API key (for auxiliary OCR on text-heavy diagrams)
# Leave blank to use Gemini Vision only (recommended for v1)
# GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_key_here

# Max upload size enforced on the API route (bytes). Default: 10MB
NEXT_PUBLIC_MAX_UPLOAD_BYTES=10485760
